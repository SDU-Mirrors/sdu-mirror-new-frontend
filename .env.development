# 启用 HTTPS 强制跳转（设为 false 可在本地禁用）
VITE_APP_ENABLE_HTTPS_REDIRECT=false

# ========== MOCK 数据总开关 ==========
# 全局开关：设为 false 则所有 MOCK 功能关闭，全部使用真实数据
# 设为 true 时，由下方的小开关分别控制各模块
VITE_APP_USE_MOCK_DATA=true

# ========== 各模块 MOCK 开关（仅在总开关为 true 时生效） ==========
# 镜像列表和 ISO 下载链接
VITE_APP_MOCK_MIRRORS=true
# 帮助页面列表和内容
VITE_APP_MOCK_HELPS=true
# 文档页面列表和内容
VITE_APP_MOCK_DOCUMENTS=true

# API 基础地址（当 MOCK 关闭时使用）
VITE_APP_BASE_URL="https://mirrors.sdu.edu.cn"
